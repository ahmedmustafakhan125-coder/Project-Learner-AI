{
  "name": "ai-edu-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.10.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:conformance": "turbo run test:conformance",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "db:start": ".\\.tools\\supabase.exe start",
    "db:stop": ".\\.tools\\supabase.exe stop",
    "db:reset": ".\\.tools\\supabase.exe db reset",
    "smoke": "node --env-file-if-exists=.env scripts/smoke-providers.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3"
  }
}
