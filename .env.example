# ---------------------------------------------------------------------------
# LLM providers
#
# Every key is OPTIONAL. A model only appears in the picker when its vendor's
# key is present, so the app runs fine with just one provider configured.
# Start with ANTHROPIC_API_KEY — it is the only vendor whose pricing is
# verified in the registry, so it is the only one that produces real cost
# figures out of the box.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Supabase
#
# `npx supabase start` prints these for the local stack. The SERVICE_ROLE key
# bypasses Row Level Security — it belongs to apps/api only and must never be
# exposed to the browser or prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-visible copies (safe: the anon key is gated by RLS).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Budgets
# ---------------------------------------------------------------------------
# Per-user daily spend ceiling in USD, enforced before each provider call.
# Usage on models with unverified pricing cannot be counted against this.
DAILY_USD_BUDGET_PER_USER=2.00

# ---------------------------------------------------------------------------
# LLM security gateway
#
# Every learner-supplied prompt is screened here before it reaches a model:
# prompt injection, jailbreaks, system-prompt extraction, secrets, and PII.
# Run the service from the llm-security-gateway-final repo:
#
#   uvicorn app.main:app --reload --port 8000
#
# Leave this unset ONLY if you accept that model-bound routes will refuse:
# unset is treated the same as unreachable, and those routes fail closed so an
# unscreened prompt can never reach an agent. Read-only routes still work.
# ---------------------------------------------------------------------------
SECURITY_GATEWAY_URL=http://127.0.0.1:8000
SECURITY_GATEWAY_TIMEOUT_MS=4000
