# ===========================================================================
# Environment structure
#
# Two files hold real values. Neither is committed.
#
#   .env                    (repo root) — read by apps/api, which loads it with
#                           --env-file, and by scripts/ (npm run smoke).
#   apps/web/.env.local     — read by Next.js for apps/web. Only the
#                           NEXT_PUBLIC_* block below goes there.
#
# Copy this file to .env and fill it in; copy the NEXT_PUBLIC_* block into
# apps/web/.env.local. Nothing else in the repo reads env files.
#
# Keep provider keys in these files only. Never `export` them in the shell
# Claude Code runs in: with ANTHROPIC_API_KEY in its environment, Claude Code
# bills that key instead of the claude.ai plan.
# ===========================================================================

# ---------------------------------------------------------------------------
# Runtime (apps/api) — all optional, defaults shown
# ---------------------------------------------------------------------------
# development | test | production. production turns on the Project Learner
# boot check and refuses PROJECT_GEN_FALLBACK=chain.
NODE_ENV=development
PORT=3001
# The web app's origin. CORS accepts exactly this origin (plus localhost).
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM providers (apps/api)
#
# Every key is optional; a model is offered only when its vendor's key is set.
# What each key powers:
#
#   GEMINI_API_KEY      Default for questions, the interview and follow-ups
#                       (Gemini 3.6 Flash) and the project tutor (Gemini 4
#                       Argon, paid tier only). The one key the app needs.
#   ANTHROPIC_API_KEY   Project generation with PROJECT_LEARNER=on (Claude
#                       Sonnet 5.5 and Opus 5.5). Needs Claude Console credits;
#                       a claude.ai Pro plan does not cover API calls.
#   OPENAI_API_KEY      Optional extra models in the picker.
#   DEEPSEEK_API_KEY    Optional; pricing unverified, so its spend is not
#                       counted against budgets.
#   OPENROUTER_API_KEY  Optional; mostly unpriced.
#   MOONSHOT_API_KEY    Optional; unpriced.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (apps/api) — required
#
# `npm run db:start` prints these for the local stack. The SERVICE_ROLE key
# bypasses Row Level Security — it belongs to apps/api only and must never be
# exposed to the browser or prefixed with NEXT_PUBLIC_.
# SUPABASE_ANON_KEY is read only by the RLS live suite (npm run test:rls).
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Budgets (apps/api)
# ---------------------------------------------------------------------------
# Per-user daily spend ceiling in USD, enforced before each provider call.
# Usage on models with unverified pricing cannot be counted against this.
# With PROJECT_LEARNER=on it covers questions only; projects have their own.
DAILY_USD_BUDGET_PER_USER=2.00

# ---------------------------------------------------------------------------
# Project Learner (apps/api, docs/project-learner.md)
# ---------------------------------------------------------------------------
# on | off. Off keeps today's project flow exactly. On routes project
# generation to Claude via PROJECT_MODELS, the tutor to Gemini 4 Argon, and
# gives projects a weekly allowance. In production, on without
# ANTHROPIC_API_KEY refuses to boot.
PROJECT_LEARNER=off
# fail | chain. chain runs project generation on the Gemini chain when no
# Claude key is set. Development only; refused in production.
PROJECT_GEN_FALLBACK=fail
# Per-user spend ceiling for project:* tasks over seven days, in USD.
# Only read with PROJECT_LEARNER=on.
PROJECT_USD_BUDGET_PER_USER_PER_WEEK=5.00

# ---------------------------------------------------------------------------
# Web (apps/web) — put this block in apps/web/.env.local
#
# Inlined at build time like every NEXT_PUBLIC_ value: set them before the
# build. Browser-visible, so nothing secret here (the anon key is gated by RLS).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the browser reaches apps/api. Defaults to http://localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001
# The origin the browser sees, e.g. https://app.example.com. The /sandbox route
# builds its Content-Security-Policy from this and names it as the target of
# every postMessage the sandbox sends back.
#
# Leave it unset locally: the route falls back to the request's own origin,
# which is right on localhost. In production SET IT. The fallback rebuilds the
# origin from the Host header, and a proxy that forwards `$host` unvalidated
# lets a caller put their own origin into the sandbox's script-src and
# connect-src. A deployment running on the fallback logs a warning saying so.
NEXT_PUBLIC_APP_ORIGIN=

# ---------------------------------------------------------------------------
# Obsolete — delete if present
# ---------------------------------------------------------------------------
# SECURITY_GATEWAY_URL, SECURITY_GATEWAY_TIMEOUT_MS: the security gateway now
# runs inside apps/api; nothing reads these.

# ---------------------------------------------------------------------------
# Test-only (set on the command line, not in .env)
# ---------------------------------------------------------------------------
# CONFORMANCE_MODELS=gemini-4-argon   narrows `npm run test:conformance` to the
#                                     listed registry ids (comma-separated).
