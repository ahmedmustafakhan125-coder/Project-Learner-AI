{
  "name": "@ai-edu/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsc -b && node dist/evaluate.js",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "compromise": "^14.18.0",
    "libphonenumber-js": "^1.13.14",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
